#!/usr/bin/env bash
set -euo pipefail

export EIRINCHAN_STATE_ROOT="@EIRINCHAN_STATE_ROOT@"
export RELEASE_TMP="$EIRINCHAN_STATE_ROOT/tmp/release"

set -a
# shellcheck source=/dev/null
source "@EIRINCHAN_SHARED_ENV@"
set +a

SECRET_KEY_BASE="$(tail -n 1 "@EIRINCHAN_SECRET_KEY_FILE@")"
export SECRET_KEY_BASE

export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
export RELEASE_NODE="${RELEASE_NODE:-eirinchan@127.0.0.1}"
export ERL_EPMD_ADDRESS=127.0.0.1
export ERL_AFLAGS="${ERL_AFLAGS:-} -kernel inet_dist_use_interface {127,0,0,1}"

exec "$(dirname -- "$0")/eirinchan" rpc "Eirinchan.LogRetention.run!()"
