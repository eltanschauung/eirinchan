#!/usr/bin/env sh
# Dedicated-identity/systemd-credential profile. Does not read an operator home.
set -eu
export PHX_SERVER=true
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
export EIRINCHAN_STATE_ROOT="${EIRINCHAN_STATE_ROOT:-/var/lib/eirinchan}"
export RELEASE_TMP="${RELEASE_TMP:-/run/eirinchan/release}"
exec "$(dirname -- "$0")/eirinchan" start
