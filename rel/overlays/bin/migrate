#!/usr/bin/env bash
set -euo pipefail

export EIRINCHAN_STATE_ROOT="@EIRINCHAN_STATE_ROOT@"
export PHX_SERVER=true
export PHX_HOST=bantculture.com
export PORT=4001
export RELEASE_TMP="$EIRINCHAN_STATE_ROOT/tmp/release"

set -a
# shellcheck source=/dev/null
source /home/telemazer/.config/eirinchan-shared.env
set +a

SECRET_KEY_BASE="$(tail -n 1 /home/telemazer/.config/eirinchan4001/secret_key_base)"
export SECRET_KEY_BASE
install -d -m 0700 "$RELEASE_TMP"

exec "$(dirname -- "$0")/eirinchan" eval "Eirinchan.Release.migrate()"
