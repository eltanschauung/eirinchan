<header>
  <h1>{PostView.board_heading(@board)}</h1>
  <div class="subtitle">{@board_chrome.subtitle || @board.subtitle}</div>
  <.admin_shortcuts moderator={@current_moderator} />
</header>

<%= if @board_chrome.top_news_html do %>
  {raw(@board_chrome.top_news_html)}
<% end %>

<%= if @news_blotter_html && @news_blotter_html != "" do %>
  {raw(@news_blotter_html)}
<% end %>

<form
  name="post"
  enctype="multipart/form-data"
  action="/post.php"
  method="post"
  id="new-thread-form"
  data-post-form
  data-ajax-action={~p"/api/post"}
  data-max-images={@config.max_images}
  data-remember-stuff
  data-board-uri={@board.uri}
  data-draft-key="new"
>
  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
  <input type="hidden" name="board" value={@board.uri} />
  <input type="hidden" name="page" value={@page_data.page} />

  <table>
    <tr :if={!@config.field_disable_name}>
      <th>Name</th>
      <td>
        <input
          type="text"
          name="name"
          size="25"
          maxlength={@config.max_name_length}
          autocomplete="off"
          placeholder={@config.anonymous}
        />
        <span :if={@config.country_flags && @config.allow_no_country}>
          <input id="no_country" name="no_country" type="checkbox" value="1" />
          <label for="no_country">Don't show my flag</label>
        </span>
      </td>
    </tr>
    <tr :if={!@config.field_disable_email}>
      <th>
        {if Map.get(@config, :field_email_selectbox, false) ||
              Map.get(@config, :hide_email, false),
            do: "Options",
            else: "Email"}
      </th>
      <td>
        <select
          :if={
            Map.get(@config, :field_email_selectbox, false) ||
              Map.get(@config, :hide_email, false)
          }
          name="email"
          id="email_selectbox"
          autocomplete="off"
        >
          <option value=""></option>
          <option value="sage">sage</option>
        </select>
        <input
          :if={
            !(Map.get(@config, :field_email_selectbox, false) ||
                Map.get(@config, :hide_email, false))
          }
          type="text"
          name="email"
          size="25"
          maxlength={@config.max_email_length}
          autocomplete="off"
        />
      </td>
    </tr>
    <tr :if={!@config.field_disable_subject}>
      <th>Subject</th>
      <td>
        <input
          style="float:left;"
          type="text"
          name="subject"
          size="25"
          maxlength={@config.max_subject_length}
          autocomplete="off"
        />
        <input
          accesskey="s"
          style="margin-left:2px;"
          type="submit"
          name="post"
          value={@config.button_newtopic}
        />
        <span>
          <input id="spoiler" name="spoiler" type="checkbox" value="1" />
          <label for="spoiler">Spoiler</label>
        </span>
      </td>
    </tr>
    <tr>
      <th>Comment</th>
      <td>
        <textarea name="body" id="body" rows="5" cols="35" data-post-body></textarea>
      </td>
    </tr>
    <tr
      :if={
        captcha_enabled?(@config, @browser_challenge_required?) &&
          @config.captcha.provider == "native"
      }
      class="captcha"
    >
      <th>Verification</th>
      <td>
        <label data-captcha-lazy>
          <span>{@config.captcha.challenge || "Captcha"}</span>
          <input type="text" name="captcha" placeholder="Captcha" />
        </label>
      </td>
    </tr>
    <tr :if={
      captcha_enabled?(@config, @browser_challenge_required?) &&
        @config.captcha.provider == "recaptcha"
    }>
      <th>Verification</th>
      <td>
        <input type="text" name="g-recaptcha-response" placeholder="reCAPTCHA" data-captcha-lazy />
      </td>
    </tr>
    <tr :if={
      captcha_enabled?(@config, @browser_challenge_required?) &&
        @config.captcha.provider == "hcaptcha"
    }>
      <th>Verification</th>
      <td>
        <input type="text" name="h-captcha-response" placeholder="hCaptcha" data-captcha-lazy />
      </td>
    </tr>
    <tr :if={@config.user_flag}>
      <th>Flags</th>
      <td>
        <input
          :if={@config.multiple_flags}
          type="text"
          name="user_flag"
          id="user_flag"
          autocomplete="off"
          value={@user_flag_value}
        />
        <select :if={!@config.multiple_flags} name="user_flag" id="user_flag">
          <option value="">None</option>
          <%= for {flag, text} <- @config.user_flags do %>
            <option value={flag} selected={@user_flag_value == flag}>{text}</option>
          <% end %>
        </select>
      </td>
    </tr>
    <tr :if={is_map(@config.allowed_tags)}>
      <th>Tag</th>
      <td>
        <select name="tag">
          <%= for {tag, label} <- @config.allowed_tags do %>
            <option value={tag}>{label}</option>
          <% end %>
        </select>
      </td>
    </tr>
    <tr id="upload">
      <th>File</th>
      <td>
        <.file_selector_shell
          input_name={if @config.max_images > 1, do: "files[]", else: "file"}
          input_id="upload_file"
          multiple={@config.max_images > 1}
          upload_by_url_enabled={@config.upload_by_url_enabled}
        />
      </td>
    </tr>
    <tr
      :if={Map.get(@config, :enable_embedding, false) && Map.get(@config, :post_form_embed, true)}
      id="upload_embed"
    >
      <th>Embed</th>
      <td>
        <input
          type="text"
          name="embed"
          value=""
          size="30"
          maxlength={@config.max_embed_length}
          autocomplete="off"
        />
      </td>
    </tr>
    <tr :if={!@config.field_disable_password}>
      <th>Password</th>
      <td>
        <input
          type="text"
          name="password"
          value=""
          size="12"
          maxlength={@config.post_password_max_length}
          autocomplete="off"
        />
        <span class="unimportant">(For file deletion.)</span>
      </td>
    </tr>
    <tr :if={@config.antispam_question}>
      <th>{@config.antispam_question}</th>
      <td>
        <input
          type="text"
          name="antispam_answer"
          value=""
          size="12"
          maxlength="18"
          autocomplete="off"
        />
      </td>
    </tr>
  </table>

  <input
    :if={@config.hidden_input_hash}
    type="hidden"
    name={@config.hidden_input_name}
    value={@config.hidden_input_hash}
  />
</form>

<%= if @board_chrome.post_form_blotter_html do %>
  <hr />
  {raw(@board_chrome.post_form_blotter_html)}
<% end %>
<div id="global-message-refresh-target">
  <%= if @global_message_html && @global_message_html != "" do %>
    {raw(@global_message_html)}
  <% else %>
    <hr />
  <% end %>
</div>
<%= if @config.board_search && @config.search_enabled do %>
  <!-- Start Search Form -->
  <form style="display:inline;" action="/search.php" method="get">
    <p class="board-search-row" style="margin: 8px;">
      <span class="board-search-form-controls">
        <input
          type="text"
          class="board-search-input"
          name="search"
          placeholder="Search"
          maxlength={@config.search_max_query_length}
        />
        <input type="hidden" name="board" value={@board.uri} />
        <input type="submit" value="Search" style="margin-right:4px;" />
      </span>
      <span class="board-search-links">
        <%= for link <- EirinchanWeb.BoardChrome.search_links(@board.uri, @config) do %>
          <a style="text-decoration:none;" href={link.href}>{link.label}</a>
        <% end %>
        <a
          :if={is_binary(@config.archive_url) and @config.archive_url != ""}
          style="text-decoration:none;"
          href={@config.archive_url}
        >
          [Archive]
        </a>
        <.live_updater
          page_kind={:index}
          poll_interval_seconds={@config.auto_updater_poll_interval_seconds}
        />
      </span>
    </p>
  </form>
  <!-- End Search Form -->
<% end %>
<p :if={@page_data.threads == []} class="unimportant">No threads yet.</p>

<.index_threads {assigns} />
<.board_postcontrols board_uri={@board.uri} config={@config} />
<.board_pages_target page_data={@page_data} board_uri={@board.uri} config={@config} />

<%= if @board_chrome.show_footer do %>
  <EirinchanWeb.PostComponents.site_footer />
<% end %>
