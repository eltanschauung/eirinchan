<div class="box-wrap rules-page-shell">
  <div class="box middle">
    <h2><i>Global rules</i></h2>
    <div class="content">
      <ol>
        <li>Do not post content that is illegal in the server's jurisdiction.</li>
        <li>Do not disrupt the service, evade moderation, or abuse other users.</li>
        <li>Follow the topic and any additional rules shown on the board.</li>
      </ol>
    </div>
  </div>

  <div class="box middle">
    <h2><i>Contact</i></h2>
    <div class="content">
      <p>
        Questions may be sent to <a href={"mailto:" <> @contact_email}><%= @contact_email %></a>.
      </p>
    </div>
  </div>
</div>
