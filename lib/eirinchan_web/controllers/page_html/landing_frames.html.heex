<header class="landing-header">
  <h1><%= @landing_settings["title"] %></h1>

  <div :if={@landing_settings["subtitle"] != ""} class="subtitle">
    <%= @landing_settings["subtitle"] %>
  </div>
</header>

<main class="landing-frames" data-landing-theme={@landing_theme}>
  <iframe
    id="landing-sidebar"
    name="landing-sidebar"
    src={@sidebar_path}
    title={"#{@landing_settings["title"]} navigation"}
  >
  </iframe>
  <iframe
    id="landing-main"
    name="landing-main"
    src={@news_path}
    title={"#{@landing_settings["title"]} content"}
  >
  </iframe>
</main>
