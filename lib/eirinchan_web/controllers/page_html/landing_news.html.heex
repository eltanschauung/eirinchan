<header class="landing-header">
  <h1><%= @landing_settings["title"] %></h1>

  <div :if={@landing_settings["subtitle"] != ""} class="subtitle">
    <%= @landing_settings["subtitle"] %>
  </div>
</header>

<main class="box-wrap landing-frame-content">
  <%= raw(@sanitized_home_body) %>
  <section class="mainBox landing-news">
    <h2>News</h2>

    <p :if={@news_entries == []} class="unimportant">(No news to show.)</p>

    <article :for={entry <- @news_entries}>
      <h3><%= entry.date %></h3>

      <div><%= raw(Eirinchan.NewsBlotter.render_message_html(entry.message)) %></div>
    </article>
  </section>
  <.recent_panels recent_images={@recent_images} recent_posts={@recent_posts} stats={@stats} />
</main>
<hr /> <EirinchanWeb.PostComponents.site_footer />
