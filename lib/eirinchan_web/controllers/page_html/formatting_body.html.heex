<div class="box-wrap formatting-page-shell">
  <div class="box middle">
    <h2>Formatting</h2>
    <div class="content">
      <p><code>&gt;text</code> creates a quote. <code>&gt;&gt;123</code> links to post 123.</p>
      <p>
        <code>**text**</code>
        is bold, <code>*text*</code>
        is italic, and <code>~~text~~</code>
        is struck through.
      </p>
    </div>
  </div>

  <div class="box middle">
    <h2>Configured stickers</h2>
    <div class="content formatting-sticker-columns">
      <div>
        <%= for sticker <- @left_stickers do %>
          <p>
            <code>:<%= sticker.token %>:</code> <img src={sticker.path} alt={sticker.token} />
          </p>
        <% end %>
      </div>
      <div>
        <%= for sticker <- @right_stickers do %>
          <p>
            <code>:<%= sticker.token %>:</code> <img src={sticker.path} alt={sticker.token} />
          </p>
        <% end %>
      </div>
    </div>
    <p :if={@left_stickers == [] and @right_stickers == []}>No stickers are configured.</p>
  </div>
</div>
