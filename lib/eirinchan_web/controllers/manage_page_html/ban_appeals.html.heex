<.flash_group flash={@flash} />
<.page_header
  title={"Ban appeals (#{length(@appeals)})"}
  back_href={~p"/manage"}
  back_label="Back to Manage"
/>

<section>
  <%= if @appeals == [] do %>
    <.empty_notice text="No appeals." class_name="" centered={false} parenthesize={false} />
  <% else %>
    <%= for appeal <- @appeals do %>
      <article>
        <h2>Appeal #<%= appeal.id %></h2>
        <p :if={appeal.ban && appeal.ban.board}>
          Board: <a href={"/#{appeal.ban.board.uri}"}>/<%= appeal.ban.board.uri %>/</a>
        </p>
        <p>Status: <%= appeal.status %></p>
        <p>
          IP:
          <%= if ban_target_known?(appeal.ban) do %>
            <a class="ip-link" style="margin:0;" href={ban_target_href(appeal.ban)}>
              [<%= ban_target(appeal.ban) %>]
            </a>
          <% else %>
            Unknown
          <% end %>
        </p>
        <p>Ban reason: <%= ban_reason(appeal.ban) %></p>
        <p>Appeal: <%= appeal.body %></p>
        <p :if={appeal.resolution_note}>Resolution: <%= appeal.resolution_note %></p>
        <form action={"/manage/ban-appeals/browser/#{appeal.id}"} method="post">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <input type="hidden" name="_method" value="patch" />
          <button type="submit" name="status" value="resolved">
            Unban <%= ban_target_kind(appeal.ban) %>
          </button>
          <button type="submit" name="status" value="rejected">Reject Appeal</button>
        </form>
      </article>
    <% end %>
  <% end %>
</section>
