<.flash_group flash={@flash} />
<section class="mod-action-shell">
  <h1>Move reply #<%= EirinchanWeb.PostView.public_post_id(@post) %> from /<%= @board.uri %>/</h1>
  <p class="mod-action-back"><a href={~p"/manage"}>&larr; Back to Manage</a></p>
  <p :if={@error} class="error"><%= @error %></p>

  <form
    class="mod-action-form"
    action={"/manage/boards/#{@board.uri}/posts/#{EirinchanWeb.PostView.public_post_id(@post)}/browser/move"}
    method="post"
  >
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
    <input type="hidden" name="_method" value="patch" />
    <fieldset>
      <legend>Destination</legend>
      <label for="target_board_uri">Target board</label>
      <select id="target_board_uri" name="target_board_uri" required>
        <%= for board <- @boards do %>
          <option value={board.uri}>/<%= board.uri %>/</option>
        <% end %>
      </select>

      <label for="target_thread_id">Target thread ID</label>
      <input id="target_thread_id" type="text" name="target_thread_id" inputmode="numeric" required />

      <div class="mod-form-actions">
        <button type="submit">Move Reply</button>
      </div>
    </fieldset>
  </form>
</section>
