<.flash_group flash={@flash} />

<form
  action={~p"/manage/bans/browser"}
  method="post"
  class="banform"
  data-banlist-url={~p"/manage/bans/browser.json"}
>
  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

  <div class="banlist-opts" aria-label="Ban list controls">
    <div class="checkboxes">
      <label :if={@only_mine_available?}>
        <input
          type="checkbox"
          id="only_mine"
          name="only_mine"
          value="1"
          checked={@filters["only_mine"] == "1"}
        /> Show only bans from boards I moderate
      </label>
      <label>
        <input
          type="checkbox"
          id="only_not_expired"
          name="only_not_expired"
          value="1"
          checked={@filters["only_not_expired"] == "1"}
        /> Show only active bans
      </label>
    </div>
    <div class="buttons">
      <label class="banlist-search" for="search">
        <span>Search bans</span>
        <input
          type="search"
          id="search"
          name="search"
          placeholder="Target, reason, board, or staff"
          value={@filters["search"]}
          autocomplete="off"
        />
      </label>
      <button type="submit" id="unban" name="action" value="unban" disabled>
        Unban selected
      </button>
      <button
        type="submit"
        name="action"
        value="filter"
        style="display:none"
        aria-hidden="true"
        tabindex="-1"
      >
      </button>
    </div>
  </div>

  <p id="banlist-status" class="banlist-status" role="status" aria-live="polite">
    Loading bans...
  </p>

  <nav
    id="banlist-pagination-top"
    class="banlist-pagination"
    data-ban-pagination
    aria-label="Ban list pages (top)"
    aria-busy="true"
  >
    <span class="banlist-pagination-placeholder" aria-hidden="true">Previous [1] Next</span>
  </nav>

  <div class="banlist-table-wrap">
    <table class="mod banlist-table" id="banlist" aria-busy="true">
      <caption class="banlist-visually-hidden">Bans</caption>
      <colgroup>
        <col class="banlist-col-target" />
        <col class="banlist-col-reason" />
        <col class="banlist-col-context" />
        <col class="banlist-col-timing" />
        <col class="banlist-col-action" />
      </colgroup>
      <thead>
        <tr>
          <th scope="col" class="banlist-target-heading">
            <input type="checkbox" id="select-all" aria-label="Select all visible bans" />
            <button type="button" class="banlist-sort" data-ban-sort="mask">Target</button>
          </th>
          <th scope="col">
            <button type="button" class="banlist-sort" data-ban-sort="reason">Reason</button>
          </th>
          <th scope="col">
            <button type="button" class="banlist-sort" data-ban-sort="board">Scope</button>
          </th>
          <th scope="col">
            <button type="button" class="banlist-sort" data-ban-sort="created">Timing</button>
          </th>
          <th scope="col">Edit</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={_ <- 1..6} class="banlist-skeleton-row" aria-hidden="true">
          <td data-label="Target"><span class="banlist-skeleton-line"></span></td>
          <td data-label="Reason"><span class="banlist-skeleton-line"></span></td>
          <td data-label="Scope"><span class="banlist-skeleton-line"></span></td>
          <td data-label="Timing"><span class="banlist-skeleton-line"></span></td>
          <td data-label="Edit"><span class="banlist-skeleton-line"></span></td>
        </tr>
      </tbody>
    </table>
  </div>

  <nav
    id="banlist-pagination-bottom"
    class="banlist-pagination"
    data-ban-pagination
    aria-label="Ban list pages (bottom)"
    aria-busy="true"
  >
    <span class="banlist-pagination-placeholder" aria-hidden="true">Previous [1] Next</span>
  </nav>
</form>
