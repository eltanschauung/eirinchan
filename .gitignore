# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
eirinchan-*.tar

AGENTS.md
/eirinchan_style_selector_spec.md
/priv/static/stickers/
/priv/static/error_pages/*.png

# Local runtime state
/.eirinchan/
/.eirinchan.new.*/
/access.log
/var/settings.json
/var/*.tmp
/var/.*.tmp
/var/invalid_uploads/
/var/geoip/
/var/log/

# Locally licensed GeoIP databases
*.mmdb
GeoIP.conf

# JavaScript toolchain and generated local audit output
/node_modules/
/var/javascript-audit.md
/var/javascript-audit.json

# Local archive.ph thread recovery research, fixtures, and downloaded snapshots
/archive_ph_thread_imports_plan/

# Local research for adapting 4chan X's Pixiv Sauce behavior to Eirinchan
/eirinchan_pixiv_sauce/
