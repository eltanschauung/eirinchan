[Unit]
Description=Purge Eirinchan logging data older than seven whole days
Requires=bantculture-phoenix.service
After=bantculture-phoenix.service

[Service]
Type=oneshot
User=telemazer
Group=telemazer
WorkingDirectory=@EIRINCHAN_STATE_ROOT@
ExecStart=/opt/eirinchan/current/bin/log-retention
ExecStart=+/usr/bin/find /home/telemazer/logs -type f ! -name *.log -mmin +10080 -delete
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@EIRINCHAN_STATE_ROOT@/tmp
ReadWritePaths=@EIRINCHAN_STATE_ROOT@/var
ReadWritePaths=/home/telemazer/logs
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
UMask=0077
