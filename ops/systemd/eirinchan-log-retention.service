[Unit]
Description=Purge Eirinchan logging data older than seven whole days
Requires=@EIRINCHAN_SERVICE@
After=@EIRINCHAN_SERVICE@

[Service]
Type=oneshot
User=@EIRINCHAN_DEPLOY_USER@
Group=@EIRINCHAN_DEPLOY_GROUP@
WorkingDirectory=@EIRINCHAN_STATE_ROOT@
ExecStart=@EIRINCHAN_CURRENT_LINK@/bin/log-retention
ExecStart=+/usr/bin/find @EIRINCHAN_LOG_DIR@ -type f ! -name *.log -mmin +10080 -delete
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@EIRINCHAN_STATE_ROOT@/tmp
ReadWritePaths=@EIRINCHAN_STATE_ROOT@/var
ReadWritePaths=@EIRINCHAN_LOG_DIR@
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
UMask=0077
