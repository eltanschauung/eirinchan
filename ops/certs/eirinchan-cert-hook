#!/usr/bin/env bash
set -euo pipefail

CERT_ROOT=/home/telemazer/phoenix-gateway/var/certs
CHALLENGE_ROOT=/home/telemazer/phoenix-gateway/var/acme/.well-known/acme-challenge
RELOAD_MARKER=/run/eirinchan-certs/updated

valid_challenge_token() {
  [[ "$1" =~ ^[A-Za-z0-9_-]{1,256}$ ]]
}

deploy_challenge() {
  local _domain="$1"
  local token="$2"
  local response="$3"
  local temporary_file

  valid_challenge_token "$token" || return 1
  install -d -m 0755 -o telemazer -g telemazer "$CHALLENGE_ROOT"
  temporary_file="$(mktemp "$CHALLENGE_ROOT/.challenge.XXXXXX")"
  trap 'rm -f -- "$temporary_file"' RETURN
  printf '%s' "$response" >"$temporary_file"
  chown telemazer:telemazer "$temporary_file"
  chmod 0644 "$temporary_file"
  mv -fT "$temporary_file" "$CHALLENGE_ROOT/$token"
  trap - RETURN
}

clean_challenge() {
  local _domain="$1"
  local token="$2"

  valid_challenge_token "$token" || return 1
  rm -f -- "$CHALLENGE_ROOT/$token"
}

deploy_cert() {
  local domain="$1"
  local keyfile="$2"
  local _certfile="$3"
  local fullchainfile="$4"
  local _chainfile="$5"
  local _timestamp="$6"
  local target_dir="$CERT_ROOT/$domain"
  local temporary_dir

  install -d -m 0700 -o telemazer -g telemazer "$target_dir"
  temporary_dir="$(mktemp -d "$target_dir/.deploy.XXXXXX")"
  trap 'rm -rf -- "$temporary_dir"' RETURN

  install -m 0600 -o telemazer -g telemazer "$fullchainfile" "$temporary_dir/fullchain.pem"
  install -m 0600 -o telemazer -g telemazer "$keyfile" "$temporary_dir/privkey.pem"
  mv -fT "$temporary_dir/fullchain.pem" "$target_dir/fullchain.pem"
  mv -fT "$temporary_dir/privkey.pem" "$target_dir/privkey.pem"
  rmdir "$temporary_dir"
  trap - RETURN
  touch "$RELOAD_MARKER"
}

exit_hook() {
  if [[ -e "$RELOAD_MARKER" ]]; then
    rm -f "$RELOAD_MARKER"
    systemctl try-restart phoenix-gateway.service
  fi
}

HANDLER="${1:-}"
if declare -F "$HANDLER" >/dev/null; then
  shift
  "$HANDLER" "$@"
fi
