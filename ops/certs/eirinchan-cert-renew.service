[Unit]
Description=Renew Eirinchan gateway certificates with dehydrated
After=network-online.target phoenix-gateway.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/dehydrated --cron --config /etc/dehydrated/eirinchan.conf
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/dehydrated
ReadWritePaths=/home/telemazer/phoenix-gateway/var/acme
ReadWritePaths=/home/telemazer/phoenix-gateway/var/certs
RuntimeDirectory=eirinchan-certs
RuntimeDirectoryMode=0700
NoNewPrivileges=true
UMask=0077
